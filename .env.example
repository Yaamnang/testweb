# Every variable the site reads. Copy to .env.local and fill in what you need.
# All are optional: with none set the site uses the in-memory store and the mock AI.

# Storage. STORE=supabase uses Postgres; the other two must then be set.
STORE=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# AI: mock (default), claude or replay. claude needs the key.
AI_MODE=
ANTHROPIC_API_KEY=

# Sign-in and sign-up extras. Both are treated as off when QA_SUITE=on.
CAPTCHA=
CAPTCHA_SECRET=
EMAIL_CODE=

# QA_SUITE=on: a target for the full suite from the QA console. Turns CAPTCHA and EMAIL_CODE off.
QA_SUITE=
# SETUP_KEY: turns on the /setup page that creates the QA test data. Unset it when done.
SETUP_KEY=

# Planted bugs, comma separated (lib/bug-catalog.ts).
BUGS=

# Plain http deployments only.
INSECURE_COOKIES=

# QA bot and viewer, created at start (in-memory) or by npm run db:seed.
SEED_QA_EMAIL=
SEED_QA_PASSWORD=
SEED_QA_TOTP_SECRET=
SEED_QA_VIEWER_EMAIL=
SEED_QA_VIEWER_PASSWORD=
SEED_QA_VIEWER_TOTP_SECRET=
